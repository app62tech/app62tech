{
  // See https://developers.cloudflare.com/workers/wrangler/configuration/
  "name": "app62tech",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // Burst protection for /api/contact: 3 submissions per minute per IP
  // (Workers rate limiting allows only 10s/60s windows; counts are per
  // Cloudflare location and approximate by design).
  "ratelimits": [
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  // Secrets (TURNSTILE_SECRET_KEY, RESEND_API_KEY) are set in the Cloudflare
  // dashboard or via `wrangler secret put <NAME>` — never committed here.
  "vars": {
    "TURNSTILE_SITE_KEY": "",
    "CONTACT_TO_EMAIL": "hello@app62.tech",
    "CONTACT_FROM_EMAIL": "App62 website <hello@app62.tech>",
  },
}
