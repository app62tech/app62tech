{
  "name": "app62tech",
  "description": "App62 marketing site — Astro + Tailwind CSS on Cloudflare Workers.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
