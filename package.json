    "fix:prettier": "prettier -w .",
    "test:a11y": "node scripts/check-a11y.mjs",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "12.6.12",
