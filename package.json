    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.9",
    "astro": "5.16.9",
    "astro-icon": "^1.1.5",
    "astro-seo": "^1.1.0",
    "limax": "4.2.3",
    "lodash.merge": "^4.6.2",
    "unpic": "^4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
