---
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import cardlynkScreenshots from '~/assets/images/work/cardlynk-screenshots.png';
import cardlynkIcon from '~/assets/images/work/cardlynk-icon.png';

export const prerender = true;

const works = await getCollection('work');
const cardlynk = works.find((w) => w.id === 'cardlynk')!;

const metadata = {
  title: cardlynk.data.title,
  description: cardlynk.data.whatWasBuilt,
};

const softwareAppLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: cardlynk.data.title,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'iOS',
  ...(cardlynk.data.appStoreUrl ? { url: cardlynk.data.appStoreUrl } : {}),
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppLd)} />
  <HeroText tagline="Work" title={cardlynk.data.title} />

  <WidgetWrapper containerClass="max-w-3xl mx-auto">
    <Image
      src={cardlynkIcon}
      alt="CardLynk"
      class="h-16 w-16 rounded-xl mb-6"
      widths={[200]}
      sizes="64px"
      format="webp"
    />

    <!-- Real screenshots captured from the live App Store listing (PRD §9
         approach, applied to this second case study). -->
    <Image
      src={cardlynkScreenshots}
      alt="CardLynk App Store screenshots: Business Card wallet pass, Contact Information form, Media, and QR Code screens"
      class="w-full rounded-lg border border-gray-200 mb-2"
      widths={[400, 900]}
      sizes="(max-width: 768px) 100vw, 768px"
      format="webp"
    />
    <p class="text-sm text-muted mb-12">Screenshots from the App Store listing.</p>

    <div class="space-y-8">
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">Problem</h2>
        <p class="text-lg text-default">{cardlynk.data.problem}</p>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">What was built</h2>
        <p class="text-lg text-default">{cardlynk.data.whatWasBuilt}</p>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">Surfaces</h2>
        <p class="text-lg text-default">{cardlynk.data.surfaces}</p>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">Outcome</h2>
        <p class="text-lg text-default">{cardlynk.data.outcome}</p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      {
        cardlynk.data.appStoreUrl && (
          <a class="btn-primary" href={cardlynk.data.appStoreUrl} target="_blank" rel="noopener noreferrer">
            View on the App Store
          </a>
        )
      }
    </div>
  </WidgetWrapper>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get in touch', href: getPermalink('/contact') }]}
    title="Have a defined piece of work?"
    subtitle="Tell us what you need built or audited."
  />
</Layout>
