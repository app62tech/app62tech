---
import { getCollection } from 'astro:content';

import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Image from '~/components/common/Image.astro';
import { getPermalink } from '~/utils/permalinks';
import cliqueScreenshots from '~/assets/images/work/clique-screenshots.png';
import cliqueSite from '~/assets/images/work/clique-site.png';
import cliqueAppWelcome from '~/assets/images/work/clique-app-welcome.png';
import cliqueLogo from '~/assets/images/work/clique-logo.png';

export const prerender = true;

const [clique] = await getCollection('work');

const metadata = {
  title: clique.data.title,
  description: clique.data.whatWasBuilt,
};

const softwareAppLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: clique.data.title,
  applicationCategory: 'LifestyleApplication',
  operatingSystem: 'iOS',
  ...(clique.data.appStoreUrl ? { url: clique.data.appStoreUrl } : {}),
};
---

<Layout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(softwareAppLd)} />
  <HeroText tagline="Work" title={clique.data.title} />

  <WidgetWrapper containerClass="max-w-3xl mx-auto">
    <Image src={cliqueLogo} alt="Clique" class="h-8 w-auto mb-6" widths={[300]} sizes="150px" format="webp" />

    <!-- Real screenshots and app UI — captured from the live App Store
         listing, cliqueuae.com, and the shipped app itself (PRD §9). -->
    <Image
      src={cliqueScreenshots}
      alt="Clique App Store screenshots: Find Your Crowd, Start Instantly, Connect, and Meet in Real Life"
      class="w-full rounded-lg border border-gray-200 mb-4"
      widths={[400, 940]}
      sizes="(max-width: 768px) 100vw, 768px"
      format="webp"
    />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
      <Image
        src={cliqueSite}
        alt="The Clique marketing site homepage, cliqueuae.com"
        class="w-full rounded-lg border border-gray-200"
        widths={[400, 640]}
        sizes="(max-width: 640px) 100vw, 384px"
        format="webp"
      />
      <Image
        src={cliqueAppWelcome}
        alt="Clique app sign-in screen"
        class="w-full rounded-lg border border-gray-200"
        widths={[400, 640]}
        sizes="(max-width: 640px) 100vw, 384px"
        format="webp"
      />
    </div>
    <p class="text-sm text-muted mb-12">Screenshots from the App Store listing, cliqueuae.com, and the shipped app.</p>

    <div class="space-y-8">
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">Problem</h2>
        <p class="text-lg text-default">{clique.data.problem}</p>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">What was built</h2>
        <p class="text-lg text-default">{clique.data.whatWasBuilt}</p>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">Surfaces</h2>
        <p class="text-lg text-default">{clique.data.surfaces}</p>
      </div>
      <div>
        <h2 class="text-xl font-bold font-heading text-heading mb-2">Outcome</h2>
        <p class="text-lg text-default">{clique.data.outcome}</p>
      </div>
    </div>

    <div class="mt-10 flex flex-wrap gap-4">
      {
        clique.data.siteUrl && (
          <a class="btn-primary" href={clique.data.siteUrl} target="_blank" rel="noopener noreferrer">
            Visit cliqueuae.com
          </a>
        )
      }
      {
        clique.data.appStoreUrl && (
          <a class="btn" href={clique.data.appStoreUrl} target="_blank" rel="noopener noreferrer">
            View on the App Store
          </a>
        )
      }
    </div>
  </WidgetWrapper>

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get in touch', href: getPermalink('/contact') }]}
    title="Have a defined piece of work?"
    subtitle="Tell us what you need built or audited."
  />
</Layout>
