---
// Cloudflare Web Analytics — cookieless, no consent banner required (PRD §20).
// Google Analytics is intentionally not used. Does nothing until a token is
// configured in src/config.yaml (analytics.vendors.cloudflare.token).
import { ANALYTICS } from 'astrowind:config';

const token = ANALYTICS?.vendors?.cloudflare?.token ? String(ANALYTICS.vendors.cloudflare.token) : '';
---

<script is:inline define:vars={{ token }}>
  // Load the beacon after the page has loaded, so its extra connection to
  // static.cloudflareinsights.com never delays first paint or LCP. It still
  // records the visit and reads the page's timings from the Performance API.
  if (token) {
    const load = () => {
      const s = document.createElement('script');
      s.defer = true;
      s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      s.setAttribute('data-cf-beacon', JSON.stringify({ token }));
      document.head.appendChild(s);
    };
    if (document.readyState === 'complete') load();
    else window.addEventListener('load', load, { once: true });
  }
</script>
